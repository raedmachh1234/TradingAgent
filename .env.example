# Copy to .env (ignored by git). Never commit real values.
# Phase 1 needs none of these: the demo and the paper broker run offline with no credentials.

# Telegram approval channel (optional): token from @BotFather
TELEGRAM_BOT_TOKEN=

# Pin the operator public key, so a swapped config/operator.pub is rejected (printed by `quantbot keys init`)
QUANTBOT_OPERATOR_KEY_SHA256=

# Broker and data credentials arrive with their adapters. Use read-only keys for data work.
